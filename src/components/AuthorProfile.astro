---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

type Props = {
	author: CollectionEntry<'authors'>;
};

const { author } = Astro.props;
const { name, bio, avatar, socialLinks } = author.data;
---

<section class="author-profile" aria-labelledby="author-heading">
	<Image class="avatar" src={avatar} alt={`${name}'s avatar`} width={96} height={96} />
	<div class="author-details">
		<p class="eyebrow">About the author</p>
		<h2 id="author-heading">{name}</h2>
		<p>{bio}</p>
		<nav aria-label={`${name}'s social links`}>
			<ul>
				{socialLinks.map((link) => (
					<li><a href={link.url} rel="noreferrer">{link.label}</a></li>
				))}
			</ul>
		</nav>
	</div>
</section>

<style>
	.author-profile {
		display: flex;
		gap: 1.5rem;
		align-items: flex-start;
		margin-top: 4rem;
		padding-top: 2rem;
		border-top: 1px solid rgb(var(--gray-light));
	}
	.avatar {
		flex: 0 0 auto;
		width: 96px;
		height: 96px;
		object-fit: cover;
		border-radius: 50%;
	}
	.author-details {
		flex: 1;
	}
	.eyebrow {
		margin: 0;
		color: rgb(var(--gray));
		font-size: 0.8em;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}
	.author-details h2 {
		margin: 0.15rem 0 0.5rem;
		font-size: 1.5em;
	}
	.author-details p {
		margin-bottom: 0.75rem;
	}
	ul {
		display: flex;
		gap: 1rem;
		padding: 0;
		margin: 0;
		list-style: none;
	}
	@media (max-width: 480px) {
		.author-profile {
			gap: 1rem;
		}
		.avatar {
			width: 72px;
			height: 72px;
		}
	}
</style>
